{
  "name": "discord-translator-bot",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun --watch src/index.ts",
    "register": "bun run src/registerCommands.ts",
    "test": "bun typecheck && bun test",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint:md": "markdownlint-cli2 \"*.md\"",
    "format:md": "markdownlint-cli2 --fix \"*.md\"",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun test && bun run lint:md",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "discord.js": "14.27.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "bun-types": "1.4.4",
    "lefthook": "2.1.17",
    "markdownlint-cli2": "0.23.3",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "7.0.2003",
    "typescript": "7.0.2"
  }
}
